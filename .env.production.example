# Copy to .env on the deployment server and replace every placeholder.
APP_ENV=production
APP_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ALLOWED_ORIGINS=https://rag.example.com
APP_ALLOWED_HOSTS=api.example.com,api,localhost,127.0.0.1

API_DOMAIN=api.example.com
UI_DOMAIN=rag.example.com
ACME_EMAIL=admin@example.com

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=directorsrag
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MINIO_SECURE=false
MINIO_BUCKET=director-handbook

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=director_handbook

OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

BACKEND_URL=http://api:8000
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
