# Copy to .env before starting Docker Compose.
APP_ENV=development
APP_API_KEY=change-me-to-a-long-random-secret
APP_ALLOWED_ORIGINS=http://localhost:8501
APP_ALLOWED_HOSTS=localhost,127.0.0.1,api

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=directorsrag
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_SECURE=false
MINIO_BUCKET=director-handbook

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=director_handbook

OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

BACKEND_URL=http://api:8000
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
